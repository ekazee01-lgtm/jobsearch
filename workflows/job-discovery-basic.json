{
  "name": "Job Discovery - Basic RSS Feed",
  "nodes": [
    {
      "parameters": {
        "feedUrl": "https://rss.indeed.com/rss?q=AI+adoption+legal&l=Remote"
      },
      "name": "Indeed RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Daily at 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [40, 300]
    },
    {
      "parameters": {
        "jsCode": "// Normalize job data from Indeed RSS\nconst jobs = [];\n\nfor (const item of $input.all()) {\n  const job = {\n    title: item.json.title,\n    company: extractCompanyFromTitle(item.json.title),\n    description: item.json.contentSnippet || item.json.content,\n    url: item.json.link,\n    location: extractLocationFromTitle(item.json.title),\n    source: 'Indeed RSS',\n    published: item.json.pubDate,\n    raw_data: item.json\n  };\n  \n  jobs.push({ json: job });\n}\n\nfunction extractCompanyFromTitle(title) {\n  // Basic extraction - improve based on Indeed's format\n  const match = title.match(/at (.+?) in/);\n  return match ? match[1].trim() : 'Unknown';\n}\n\nfunction extractLocationFromTitle(title) {\n  // Basic extraction - improve based on Indeed's format  \n  const match = title.match(/in (.+?)$/);\n  return match ? match[1].trim() : 'Remote';\n}\n\nreturn jobs;"
      },
      "name": "Normalize Job Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/job_applications",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "company",
              "value": "={{ $json.company }}"
            },
            {
              "name": "role",
              "value": "={{ $json.title }}"
            },
            {
              "name": "url",
              "value": "={{ $json.url }}"
            },
            {
              "name": "location",
              "value": "={{ $json.location }}"
            },
            {
              "name": "source",
              "value": "={{ $json.source }}"
            },
            {
              "name": "description",
              "value": "={{ $json.description }}"
            },
            {
              "name": "status",
              "value": "To Review"
            },
            {
              "name": "user_id",
              "value": "{{ $env.USER_ID }}"
            }
          ]
        }
      },
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/webhook/n8n/jobs-found",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "type",
              "value": "new_jobs"
            },
            {
              "name": "count",
              "value": "={{ $json.length }}"
            },
            {
              "name": "source",
              "value": "Indeed RSS"
            }
          ]
        }
      },
      "name": "Notify Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [840, 300]
    }
  ],
  "connections": {
    "Daily at 9 AM": {
      "main": [
        [
          {
            "node": "Indeed RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Indeed RSS Feed": {
      "main": [
        [
          {
            "node": "Normalize Job Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Job Data": {
      "main": [
        [
          {
            "node": "Save to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Supabase": {
      "main": [
        [
          {
            "node": "Notify Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}