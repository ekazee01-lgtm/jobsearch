        }
      },
      "name": "Mark as Processed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2440, 300],
      "id": "markprocessed"
    }\n  ],\n  \"connections\": {\n    \"trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"indeed1\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"indeed2\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"indeed3\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"indeed1\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"merge\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"indeed2\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"merge\",\n            \"type\": \"main\",\n            \"index\": 1\n          }\n        ]\n      ]\n    },\n    \"indeed3\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"merge\",\n            \"type\": \"main\",\n            \"index\": 2\n          }\n        ]\n      ]\n    },\n    \"merge\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"standardize\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"standardize\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"staging\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"staging\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"dedupe\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"dedupe\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"filter\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"filter\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"aiscore\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"aiscore\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"parse\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"parse\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"scorefilter\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"scorefilter\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"save\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"save\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"markprocessed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n