    {
      "parameters": {
        "mode": "append"
      },
      "name": "Merge Job Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [640, 300],
      "id": "merge"
    },
    {
      "parameters": {
        "jsCode": "// Standardize job data from RSS sources\nconst standardizedJobs = [];\n\nfor (const item of $input.all()) {\n  try {\n    // Extract company from title (Indeed format: \"Job Title at Company in Location\")\n    let company = 'Unknown';\n    let location = 'Remote';\n    let cleanTitle = item.json.title || 'Unknown Role';\n    \n    // Parse Indeed RSS format\n    const titleMatch = cleanTitle.match(/(.+?)\\s+at\\s+(.+?)\\s+in\\s+(.+)$/);\n    if (titleMatch) {\n      cleanTitle = titleMatch[1].trim();\n      company = titleMatch[2].trim();\n      location = titleMatch[3].trim();\n    }\n    \n    // Determine source\n    let source = 'Unknown';\n    if (item.json.link && item.json.link.includes('indeed.com')) {\n      source = 'Indeed RSS';\n    }\n    \n    // Create standardized job object\n    const standardJob = {\n      title: cleanTitle,\n      company: company,\n      location: location,\n      url: item.json.link || item.json.guid || '',\n      description: item.json.contentSnippet || item.json.description || item.json.content || '',\n      source: source,\n      published: item.json.pubDate || item.json.isoDate || new Date().toISOString(),\n      rawData: {\n        originalTitle: item.json.title,\n        guid: item.json.guid,\n        categories: item.json.categories,\n        creator: item.json.creator\n      }\n    };\n    \n    // Quality checks\n    if (standardJob.url && standardJob.title && standardJob.company !== 'Unknown') {\n      standardizedJobs.push({ json: standardJob });\n    } else {\n      console.log('Skipping low-quality job:', standardJob.title);\n    }\n    \n  } catch (error) {\n    console.error('Error processing job:', error, item.json);\n  }\n}\n\nconsole.log(`Processed ${$input.all().length} raw items into ${standardizedJobs.length} standardized jobs`);\n\nreturn standardizedJobs;"
      },
      "name": "Standardize Job Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300],
      "id": "standardize"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/job_raw",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "={{ $json.source }}"
            },
            {
              "name": "raw_payload",
              "value": "={{ JSON.stringify($json) }}"
            },
            {
              "name": "processed",
              "value": "false"
            }
          ]
        }
      },
      "name": "Save to Staging",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1040, 300],
      "id": "staging"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/check_job_duplicate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
