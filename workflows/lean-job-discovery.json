              "value": "={{ $json.url }}"
            }
          ]
        }
      },
      "name": "Check Duplicates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1240, 300],
      "id": "dedupe"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Not Duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 300],
      "id": "filter"
    },
    {
      "parameters": {
        "model": "gpt-3.5-turbo",
        "messages": {
          "messages": [
            {
              "role": "system",
              "content": "You are an expert job matcher for Eric Kazee, an AI Adoption Specialist with 12+ years in legal technology.\n\nEric's Profile:\n- Legal tech expertise: iManage, NetDocuments, LexisNexis, Aderant\n- AI implementation: ChatGPT, Claude, Harvey AI, CoCounsel integration\n- Focus areas: Training, governance, compliance, change management\n- Target: Remote roles, $100k+, AI + Legal combination\n\nScoring Criteria (1-10):\n10: Perfect match (AI + Legal, remote, senior level)\n9: Excellent (AI focus with legal industry experience valued)\n8: Very good (Either AI implementation OR legal tech, remote)\n7: Good (Relevant technology role with growth potential)\n6-5: Moderate (Some relevant skills but not ideal)\n4-1: Poor match (Wrong industry, level, or location)\n\nRespond with JSON only: {\"score\": X, \"reasoning\": \"brief explanation\", \"redFlags\": \"concerns if any\"}"
            },
            {
              "role": "user",
              "content": "Job Title: {{ $json.title }}\nCompany: {{ $json.company }}\nLocation: {{ $json.location }}\nDescription: {{ $json.description }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 300
        }
      },
      "name": "AI Score Job",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [1640, 300],
      "id": "aiscore"
    },
    {
      "parameters": {
        "jsCode": "// Parse AI scoring response and prepare for database\ntry {\n  const aiResponse = $input.first().json.choices[0].message.content.trim();\n  let aiResult;\n  \n  // Try to parse JSON response\n  try {\n    aiResult = JSON.parse(aiResponse);\n  } catch (parseError) {\n    console.error('Failed to parse AI response as JSON:', aiResponse);\n    aiResult = {\n      score: 5,\n      reasoning: 'Failed to parse AI response',\n      redFlags: 'AI scoring error'\n    };\n  }\n  \n  // Get the job data from previous node\n  const jobData = $('Not Duplicate').first().json;\n  \n  // Create final job object for database\n  const finalJob = {\n    company: jobData.company,\n    role: jobData.title,\n    location: jobData.location,\n    url: jobData.url,\n    description: jobData.description,\n    source: jobData.source,\n    ai_match_score: aiResult.score || 5,\n    status: 'To Review',\n    user_id: '{{ $env.USER_ID || \"default-user\" }}',\n    created_at: new Date().toISOString(),\n    \n    // Store AI analysis for review\n    ai_reasoning: aiResult.reasoning || 'No reasoning provided',\n    ai_red_flags: aiResult.redFlags || null,\n    raw_data: jobData.rawData\n  };\n  \n  console.log(`Job scored: ${finalJob.role} at ${finalJob.company} - Score: ${finalJob.ai_match_score}`);\n  \n  return { json: finalJob };\n  \n} catch (error) {\n  console.error('Error processing AI score:', error);\n  \n  // Fallback: create job without AI score\n  const jobData = $('Not Duplicate').first().json;\n  return {\n    json: {\n      company: jobData.company,\n      role: jobData.title,\n      location: jobData.location,\n      url: jobData.url,\n      description: jobData.description,\n      source: jobData.source,\n      ai_match_score: 5,\n      status: 'To Review',\n      user_id: '{{ $env.USER_ID || \"default-user\" }}',\n      created_at: new Date().toISOString(),\n      ai_reasoning: 'AI scoring failed',\n      ai_red_flags: error.message\n    }\n  };\n}"
      },
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1840, 300],
      "id": "parse"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.ai_match_score }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Score >= 7",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2040, 300],
      "id": "scorefilter"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/job_applications",
        "sendHeaders": true,
        "headerParameters": {
