        "bodyContent": "={{ JSON.stringify($json) }}"
      },
      "name": "Save to Main DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2240, 300],
      "id": "save"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/job_raw?id=eq.{{ $('Save to Staging').first().json.id }}",
        "sendHeaders": true,
        "headerParameters": {
