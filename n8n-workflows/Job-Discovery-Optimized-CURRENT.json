    {
      "parameters": {
        "functionCode": "// Optimized job data standardization with robust regex\nconst standardizedJobs = [];\nconst userId = '542413a9-b564-423c-96c9-99d51cc01107';\n\nfor (const item of $input.all()) {\n  try {\n    let cleanTitle = item.json.title || 'Unknown Role';\n    let company = 'Unknown';\n    let location = 'Remote';\n\n    // Strategy 1: Indeed \\\"Title at Company in Location\\\"\n    const indeedMatch = cleanTitle.match(/(.+?)\\\\s+at\\\\s+(.+?)\\\\s+in\\\\s+(.+)$/i);\n    \n    // Strategy 2: Common \\\"Title - Company\\\" format\n    const dashMatch = cleanTitle.match(/(.+?)\\\\s+-\\\\s+(.+)$/);\n    \n    // Strategy 3: Company: Title format\n    const colonMatch = cleanTitle.match(/(.+?):\\\\s*(.+)$/);\n\n    if (indeedMatch) {\n      cleanTitle = indeedMatch[1].trim();\n      company = indeedMatch[2].trim();\n      location = indeedMatch[3].trim();\n    } else if (dashMatch) {\n      cleanTitle = dashMatch[1].trim();\n      company = dashMatch[2].trim();\n    } else if (colonMatch) {\n      company = colonMatch[1].trim();\n      cleanTitle = colonMatch[2].trim();\n    }\n\n    const standardJob = {\n      user_id: userId,\n      title: cleanTitle,\n      company: company,\n      location: location,\n      url: item.json.link || item.json.guid || '',\n      description: item.json.contentSnippet || item.json.description || '',\n      // Identify source from link contents\n      source: item.json.link && item.json.link.includes('google.com/alerts') ? 'Google Alerts' :\n              item.json.link && item.json.link.includes('remoteok.com') ? 'RemoteOK' :\n              item.json.link && item.json.link.includes('weworkremotely.com') ? 'WeWorkRemotely' :\n              item.json.link && item.json.link.includes('indeed') ? 'Indeed' : 'RSS',\n      published: item.json.pubDate || new Date().toISOString(),\n      raw_title: item.json.title\n    };\n\n    // Basic validity check\n    if (standardJob.url && standardJob.title !== 'Unknown Role') {\n      standardizedJobs.push({ json: standardJob });\n    }\n    \n  } catch (error) {\n    console.error('Error parsing job:', error);\n  }\n}\n\nreturn standardizedJobs;"
      },
      "id": "standardize-jobs",
      "name": "Standardize Job Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "ai-filter",
              "leftValue": "={{ $json.title.toLowerCase() + ' ' + $json.description.toLowerCase() }}",
              "rightValue": "ai",
              "operator": {
                "type": "string",
                "operation": "contains",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "pre-ai-filter",
      "name": "Pre-AI Relevance Filter",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Enhanced relevance filtering to save AI costs\nconst relevantJobs = [];\nconst relevantKeywords = [\n  'ai', 'artificial intelligence', 'machine learning', 'ml',\n  'python', 'aws', 'cloud', 'implementation', 'consulting',\n  'data science', 'automation', 'genai', 'llm', 'nlp',\n  'delivery consultant', 'solution architect', 'enablement'\n];\n\nconst excludeKeywords = [\n  'sales', 'marketing', 'recruiter', 'hr', 'accounting',\n  'finance', 'legal', 'paralegal', 'nurse', 'doctor'\n];\n\nfor (const item of $input.all()) {\n  const text = (item.json.title + ' ' + item.json.description).toLowerCase();\n  \n  // Check for relevant keywords\n  const hasRelevantKeyword = relevantKeywords.some(keyword => text.includes(keyword));\n  \n  // Check for exclusion keywords\n  const hasExcludeKeyword = excludeKeywords.some(keyword => text.includes(keyword));\n  \n  // Only pass jobs that are relevant and not excluded\n  if (hasRelevantKeyword && !hasExcludeKeyword) {\n    relevantJobs.push(item);\n  }\n}\n\nreturn relevantJobs;"
      },
      "id": "relevance-filter",
      "name": "Smart Relevance Filter",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
