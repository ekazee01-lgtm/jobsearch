      "parameters": {
        "functionCode": "// Parse AI score and update job record\nconst scoreText = $json.content || '0';\nconst score = parseInt(scoreText.match(/\\d+/)?.[0] || '0');\n\nreturn [{\n  json: {\n    job_id: $('Save to Staging (Auto-Dedupe)').item.json.id,\n    ai_score: Math.min(Math.max(score, 1), 10), // Ensure score is 1-10\n    scored_at: new Date().toISOString()\n  }\n}];"
      },
