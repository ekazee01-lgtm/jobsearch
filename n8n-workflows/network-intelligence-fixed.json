        "options": {
          "queryName": "user_id",
          "queryValue": "542413a9-b564-423c-96c9-99d51cc01107",
          "additionalFields": {
            "filters": "ai_score=gte.8,application_status=in.(discovered,to_review)",
            "orderBy": "ai_score.desc",
            "limit": "5"
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "C8yUrpS7o6eVoW2L",
          "name": "Supabase account"
        }
      },
      "id": "get-highscore",
      "name": "Get High-Score Jobs (8+)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $items('Get High-Score Jobs (8+)').length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-jobs",
      "name": "High-Score Jobs Exist?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "id": "split-jobs",
      "name": "Process Each Job",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "\nreturn $input.all().map(item => ({\n  json: {\n    job: item.json,\n    job_id: item.json.id,\n    company_slug: item.json.company.toLowerCase().replace(/[^a-z0-9]/g, '-'),\n    title_slug: encodeURIComponent(item.json.title.split(' ').slice(0,3).join(' '))\n  }\n}));\n"
      },
      "id": "prepare-job",
      "name": "Prepare Job Context",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.crunchbase.com/organization/{{ $json.job.company.toLowerCase().replace(/[^a-z0-9]/g, '-') }}",
        "waitUntil": "networkidle",
        "stealth": true,
        "actions": [
          {
            "type": "wait",
            "value": 3000
          },
          {
            "type": "evaluate",
            "code": "() => {\n  const info = {\n    name: document.querySelector('h1')?.textContent?.trim() || '',\n    description: document.querySelector('[data-cy=\"description\"]')?.textContent?.trim() || '',\n    industry: document.querySelector('[data-cy=\"industry\"]')?.textContent?.trim() || '',\n    size: document.querySelector('[data-cy=\"num_employees_enum\"]')?.textContent?.trim() || '',\n    location: document.querySelector('[data-cy=\"location\"]')?.textContent?.trim() || '',\n    website: document.querySelector('a[href^=\"http\"]')?.href || ''\n  };\n  return info;\n}"
          }
        ]
      },
      "id": "crunchbase",
      "name": "Research Company (Crunchbase)",
      "type": "n8n-nodes-playwright.playwright",
      "typeVersion": 1,
      "position": [
        1280,
        220
      ]
    },
    {
      "parameters": {
        "url": "https://www.apollo.io/companies/{{ $json.job.company.toLowerCase().replace(/[^a-z0-9]/g, '-') }}",
        "waitUntil": "domcontentloaded",
        "stealth": true,
        "actions": [
          {
            "type": "wait",
            "value": 3000
          },
          {
            "type": "evaluate",
            "code": "() => {\n  const employees = [];\n  document.querySelectorAll('.css-employee-card, .search-result, [data-testid=\"person\"]').forEach((card, idx) => {\n    if (idx < 15) {\n      const name = card.querySelector('h3, .name')?.textContent?.trim() || '';\n      const title = card.querySelector('.title, .role')?.textContent?.trim() || '';\n      const profile = card.querySelector('a')?.href || '';\n      const email = card.querySelector('[href^=\"mailto:\"]')?.href?.replace('mailto:', '') || '';\n      if (name && title) {\n        employees.push({ name, title, profile_url: profile, email });\n      }\n    }\n  });\n  return employees.length ? employees : [{ name: 'Hiring Manager', title: 'Talent Acquisition', profile_url: '', email: '' }];\n}"
          }
        ]
      },
      "id": "directory",
      "name": "Find Employees (Directory)",
      "type": "n8n-nodes-playwright.playwright",
      "typeVersion": 1,
      "position": [
        1280,
        380
      ]
    },
    {
      "parameters": {
        "functionCode": "\nconst job = $json.job;\nconst companyInfo = $node['Research Company (Crunchbase)'].json || {};\nconst employeeData = $node['Find Employees (Directory)'].json || [];\nconst insights = {\n  company_name: companyInfo.name || job.company,\n  industry: companyInfo.industry || 'Technology',\n  company_size: companyInfo.size || 'Unknown',\n  location: companyInfo.location || '',\n  description: companyInfo.description || '',\n  website: companyInfo.website || job.url,\n  strategy: companyInfo.size && companyInfo.size.includes('1-50') ? 'founder_direct' : 'hiring_managers'\n};\nreturn [{ json: { job, insights, employees: employeeData } }];\n"
      },
      "id": "combine",
      "name": "Compile Company Insights",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "\nreturn $input.all().map(item => ({\n  json: {\n    job: item.json.job,\n    insights: item.json.insights,\n    summary_context: {\n      job_id: item.json.job.id,\n      company: item.json.job.company,\n      title: item.json.job.title,\n      ai_score: item.json.job.ai_score,\n      url: item.json.job.url,\n      insights: item.json.insights\n    }\n  }\n}));\n"
      },
      "id": "summary-context",
      "name": "Prepare Summary Context",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1720,
        220
      ]
    },
    {
      "parameters": {
        "functionCode": "\nconst items = [];\nconst job = $json.job;\nconst insights = $json.insights;\nconst employees = $json.employees || [];\nemployees.forEach(emp => {\n  items.push({\n    json: {\n      job,\n      insights,\n      employee: emp\n    }\n  });\n});\nif (!employees.length) {\n  items.push({ json: { job, insights, employee: { name: 'Hiring Manager', title: job.title, profile_url: '', email: '' } } });\n}\nreturn items;\n"
      },
      "id": "fanout-employees",
      "name": "Prepare Employee Items",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1720,
        380
      ]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "id": "split-employees",
      "name": "Process Each Employee",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        1940,
        380
      ]
    },
    {
      "parameters": {
        "functionCode": "\nconst employee = $json.employee;\nconst job = $json.job;\nconst insights = $json.insights;\nlet score = 0;\nconst title = employee.title.toLowerCase();\nif (title.includes('hiring') || title.includes('talent')) score += 9;\nif (title.includes('manager') || title.includes('director')) score += 6;\nif (title.includes('lead') || title.includes('head')) score += 4;\nif (title.includes('engineer')) score += 3;\nif (insights.strategy === 'founder_direct' && (title.includes('founder') || title.includes('ceo'))) score += 8;\nif (employee.email) score += 3;\nreturn [{ json: { job, insights, employee, relevance_score: score } }];\n"
      },
      "id": "score-contact",
      "name": "Score Contact",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
