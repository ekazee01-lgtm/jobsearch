      "id": "fetch-contacts",
      "name": "Get Contacts for Job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2600,
        500
      ]
    },
    {
      "parameters": {
        "functionCode": "\nconst ctx = $json.summary_context;\nconst contacts = $items('Get Contacts for Job');\nconst rows = contacts.map(item => {\n  const data = item.json;\n  return `<tr><td>${data.name}</td><td>${data.title}</td><td>${data.metadata?.relevance_score || ''}</td><td>${data.email ? '\u2705' : '\u274c'}</td><td>${data.metadata?.strategy || ''}</td></tr>`;\n}).join('') || '<tr><td colspan=\"5\">No contacts saved yet</td></tr>';\nconst html = `\n<h2>Network Intelligence Report</h2>\n<p><strong>Company:</strong> ${ctx.company}</p>\n<p><strong>Role:</strong> ${ctx.title}</p>\n<p><strong>AI Score:</strong> ${ctx.ai_score}</p>\n<p><strong>Strategy:</strong> ${ctx.insights.strategy}</p>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n<tr><th>Name</th><th>Title</th><th>Score</th><th>Email</th><th>Strategy</th></tr>\n${rows}\n</table>`;\nreturn [{ json: { html_report: html, context: ctx } }];\n"
      },
