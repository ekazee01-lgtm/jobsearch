        "emailType": "html",
        "message": "\n<h2>Application Materials Ready</h2>\n<p><strong>Company:</strong> {{ $json.job.company }}</p>\n<p><strong>Role:</strong> {{ $json.job.title }}</p>\n<p><strong>AI Score:</strong> {{ $json.job.ai_score }}</p>\n<h3>Resume Preview</h3>\n<pre>{{ $json.resume_markdown.substring(0, 600) }}...</pre>\n<h3>Cover Letter</h3>\n<pre>{{ $json.cover_letter }}</pre>\n<p>Reply with <strong>APPROVE: {{ $json.job.company }}</strong> or <strong>REJECT: {{ $json.job.company }}</strong>.</p>\n",
        "options": {
          "attachmentsBinary": [
