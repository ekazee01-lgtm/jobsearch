    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 5,
        "filters": {
          "q": "={{ 'subject:(APPROVE ' + $json.job.company + ') OR subject:(REJECT ' + $json.job.company + ') newer_than:3d' }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "s4gUV9BG9H4CTxYF",
