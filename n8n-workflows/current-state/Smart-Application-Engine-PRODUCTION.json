    {
      "parameters": {
        "functionCode": "const fs = require('fs');\ntry {\n  const resume = fs.readFileSync('/data/assets/master-resume.md', 'utf8');\n  const template = fs.readFileSync('/data/assets/cover-letter-templates.md', 'utf8');\n  return $input.all().map(item => ({\n    json: {\n      ...item.json,\n      master_resume: resume,\n      cover_template: template\n    }\n  }));\n} catch (error) {\n  // Fallback with basic templates if file read fails\n  return $input.all().map(item => ({\n    json: {\n      ...item.json,\n      master_resume: 'ERIC KAZEE\\nAubrey, TX | 214-728-0973 | ekazee@outlook.com\\n\\nTarget Role: AI Implementation & Enablement Specialist',\n      cover_template: 'Dear Hiring Manager,\\n\\nI am writing to express my interest in the {{JOB_TITLE}} position at {{COMPANY}}.\\n\\nBest regards,\\nEric Kazee'\n    }\n  }));\n}"
      },
