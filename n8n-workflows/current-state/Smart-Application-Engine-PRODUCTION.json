    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "ekazee.careers@gmail.com",
        "subject": "🚀 Approval Needed: {{ $json.job.company }} - {{ $json.job.title }}",
        "emailType": "html",
        "message": "<h2>🎯 Application Materials Ready</h2>\\n<p><strong>Company:</strong> {{ $json.job.company }}</p>\\n<p><strong>Role:</strong> {{ $json.job.title }}</p>\\n<p><strong>AI Score:</strong> {{ $json.job.ai_score }}/10</p>\\n<p><strong>Location:</strong> {{ $json.job.location }}</p>\\n<p><strong>Source:</strong> {{ $json.job.source }}</p>\\n\\n<h3>📄 Resume Preview</h3>\\n<pre style='background:#f5f5f5;padding:10px;'>{{ $json.resume_markdown.substring(0, 600) }}...</pre>\\n\\n<h3>✉️ Cover Letter</h3>\\n<pre style='background:#f9f9f9;padding:10px;'>{{ $json.cover_letter }}</pre>\\n\\n<hr>\\n<h3>⚡ Quick Actions</h3>\\n<p>Reply with:</p>\\n<ul>\\n<li><strong>APPROVE: {{ $json.job.company }}</strong> - to send application</li>\\n<li><strong>REJECT: {{ $json.job.company }}</strong> - to skip this job</li>\\n</ul>",
        "options": {
          "attachmentsBinary": [
            {
              "property": "resume_pdf",
              "fileName": "Eric_Kazee_Resume_{{ $json.job.company.replace(/[^a-zA-Z0-9]/g, '') }}.pdf"
            }
          ]
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "s4gUV9BG9H4CTxYF",
          "name": "Gmail account"
        }
      },
