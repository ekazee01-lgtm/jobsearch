    {
      "parameters": {
        "functionCode": "return $input.all().map(item => {\n  const pdfText = `Resume for ${item.json.job.company} - ${item.json.job.title}\\n\\n` + item.json.resume_markdown;\n  const header = \"%PDF-1.4\\n\";\n  const body = \"1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\\n\" +\n               \"2 0 obj<</Type/Pages/Count 1/Kids[3 0 R]>>endobj\\n\" +\n               \"3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>>>endobj\\n\" +\n               \"4 0 obj<</Length \"+pdfText.length+\">>stream\\nBT /F1 12 Tf 72 720 Td (\" + pdfText.replace(/([\\\\()])/g, \"\\\\$1\") + \") Tj ET\\nendstream endobj\\n\" +\n               \"5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>endobj\\n\" +\n               \"xref\\n0 6\\n0000000000 65535 f\\n0000000010 00000 n\\n0000000053 00000 n\\n0000000104 00000 n\\n0000000215 00000 n\\n0000000332 00000 n\\n\" +\n               \"trailer<</Size 6/Root 1 0 R>>\\nstartxref\\n\" + (header.length + body.length) + \"\\n%%EOF\";\n  const pdf = header + body;\n  return {\n    json: item.json,\n    binary: {\n      resume_pdf: {\n        data: Buffer.from(pdf).toString('base64'),\n        mimeType: 'application/pdf',\n        fileName: `${item.json.job.company.replace(/[^a-zA-Z0-9]/g, '')}_${$now.format('YYYYMMDD')}_resume.pdf`\n      }\n    }\n  };\n});"
      },
      "id": "resume-pdf",
      "name": "Create Resume PDF",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2600, 400]
