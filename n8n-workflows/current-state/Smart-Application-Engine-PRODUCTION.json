    {
      "parameters": {
        "functionCode": "return $input.all().map(item => ({ json: { ...item.json, approval_attempt: 0, approval_status: 'pending', approval_sent_at: new Date().toISOString() } }));"
      },
      "id": "init-approval",
      "name": "Init Approval Loop",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
