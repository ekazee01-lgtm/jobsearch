        "functionCode": "const jobs = [];\nfor (const item of $input.all()) {\n  jobs.push({\n    json: {\n      job: item.json,\n      job_id: item.json.id,\n      user_id: item.json.user_id || '542413a9-b564-423c-96c9-99d51cc01107',\n      approval_attempt: 0,\n      approval_max_attempts: 12,\n      approval_status: 'pending'\n    }\n  });\n}\nreturn jobs;"
