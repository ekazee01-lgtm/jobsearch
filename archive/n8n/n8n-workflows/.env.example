# =============================================================================
# n8n Job Search Automation - Environment Variables Template (ARCHIVED)
# =============================================================================
# Historical reference only — the n8n stack was retired before deployment.
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials!

# =============================================================================
# SUPABASE DATABASE
# =============================================================================
# Get these from: https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_for_admin_operations
SUPABASE_USER_ID=your_authenticated_user_uuid

# =============================================================================
# AI APIs
# =============================================================================
# Anthropic Claude API for email classification and content generation
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API (optional, for alternative AI processing)
# Get from: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here

# =============================================================================
# GMAIL INTEGRATION
# =============================================================================
# Google OAuth credentials for Gmail access
# Get from: https://console.cloud.google.com > Credentials
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=auto_generated_after_oauth_flow

# Target email address to monitor
MONITOR_EMAIL_ADDRESS=you@example.com

# =============================================================================
# GOOGLE CALENDAR INTEGRATION
# =============================================================================
# For automated interview scheduling
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=same_as_gmail_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=same_as_gmail_client_secret
