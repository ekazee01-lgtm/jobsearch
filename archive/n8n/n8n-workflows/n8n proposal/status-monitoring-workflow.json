          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "your-supabase-anon-key"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Get Follow-up Candidates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://your-project.supabase.co/rest/v1/job_opportunities",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "eq.pending"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "your-supabase-anon-key"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f23456789012",
      "name": "Get Deadline Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check if follow-up is needed\nconst items = [];\n\nfor (const item of $input.all()) {\n  const job = item.json;\n  \n  // Calculate days since application\n  const appliedDate = new Date(job.applied_at);\n  const now = new Date();\n  const daysSince = Math.floor((now - appliedDate) / (1000 * 60 * 60 * 24));\n  \n  // Determine if follow-up is needed\n  if (daysSince >= 7 && (!job.last_followup || daysSince >= 14)) {\n    items.push({\n      json: {\n        ...job,\n        daysSinceApplication: daysSince,\n        shouldFollowUp: true,\n        followUpType: job.ai_score >= 8 ? 'priority' : 'standard'\n      }\n    });\n  }\n}\n\nreturn items;"
      },
      "id": "c3d4e5f6-a789-0123-cdef-456789abcdef",
      "name": "Process Follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "ekazee.careers@gmail.com",
        "toEmail": "={{ $json.recruiter_email || $json.application_email }}",
        "subject": "Re: {{ $json.title }} Position - Eric Kazee",
        "text": "Dear Hiring Manager,\n\nI wanted to follow up on my application for the {{ $json.title }} position submitted {{ $json.daysSinceApplication }} days ago.\n\nI remain very interested in this opportunity and would be happy to provide any additional information you might need.\n\nBest regards,\nEric Kazee",
        "options": {}
      },
      "id": "d4e5f6a7-8901-2345-defa-567890abcdef",
      "name": "Send Follow-up Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://your-project.supabase.co/rest/v1/job_opportunities?id=eq.' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "your-supabase-anon-key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"last_followup\": \"{{ $now.toISO() }}\", \"followup_count\": {{ ($json.followup_count || 0) + 1 }}}",
        "options": {}
      },
      "id": "e5f6a789-0123-4567-efab-6789012345cd",
      "name": "Update Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process deadline alerts\nconst items = [];\n\nfor (const item of $input.all()) {\n  const job = item.json;\n  \n  if (job.deadline) {\n    const deadline = new Date(job.deadline);\n    const now = new Date();\n    const daysUntil = Math.floor((deadline - now) / (1000 * 60 * 60 * 24));\n    \n    if (daysUntil <= 7 && daysUntil >= 0) {\n      items.push({\n        json: {\n          ...job,\n          daysUntilDeadline: daysUntil,\n          urgency: daysUntil <= 2 ? 'high' : 'normal'\n        }\n      });\n    }\n  }\n}\n\nreturn items;"
      },
      "id": "f6a78901-2345-6789-fabc-789012345def",
      "name": "Process Deadlines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "fromEmail": "ekazee.careers@gmail.com",
        "toEmail": "ekazee@outlook.com",
        "subject": "Job Application Deadline Alert",
        "text": "Job: {{ $json.title }}\nCompany: {{ $json.company }}\nDeadline: {{ $json.deadline }}\nDays remaining: {{ $json.daysUntilDeadline }}\n\nAI Score: {{ $json.ai_score }}\nURL: {{ $json.url }}\n\nRemember to submit your application soon!",
        "options": {}
      },
      "id": "a7890123-4567-890a-bcde-890123456abc",
      "name": "Send Deadline Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        900,
        400
      ]
    }
  ],
