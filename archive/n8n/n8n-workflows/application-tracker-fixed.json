    {
      "parameters": {
        "functionCode": "\nconst items = [];\nfor (const item of $input.all()) {\n  const appliedDate = new Date(item.json.updated_at || item.json.created_at || new Date());\n  const today = new Date();\n  const daysDiff = Math.floor((today - appliedDate) / (1000*60*60*24));\n  let followupStage = 'none';\n  let followupType = 'none';\n  let shouldFollowup = false;\n  if (daysDiff >= 6 && daysDiff <= 8) {\n    followupStage = 'week_1';\n    followupType = 'initial';\n    shouldFollowup = true;\n  } else if (daysDiff >= 13 && daysDiff <= 15) {\n    followupStage = 'week_2';\n    followupType = 'reminder';\n    shouldFollowup = true;\n  } else if (daysDiff >= 20 && daysDiff <= 22) {\n    followupStage = 'week_3';\n    followupType = 'final';\n    shouldFollowup = true;\n  }\n  const metadata = item.json.metadata || {};\n  if (metadata.last_followup_stage === followupStage) {\n    shouldFollowup = false;\n  }\n  items.push({\n    json: {\n      ...item.json,\n      days_since_applied: daysDiff,\n      followup_stage: followupStage,\n      followup_type: followupType,\n      should_followup: shouldFollowup,\n      followup_count: metadata.followup_count || 0,\n      metadata\n    }\n  });\n}\nreturn items;\n"
      },
