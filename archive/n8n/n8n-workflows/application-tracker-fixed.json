    {
      "parameters": {
        "functionCode": "\nconst classification = JSON.parse($json.content || '{}');\nlet newStatus = 'In Review';\nif (classification.classification === 'INTERVIEW_INVITE') newStatus = 'Interview Scheduled';\nelse if (classification.classification === 'REJECTION') newStatus = 'Rejected';\nelse if (classification.classification === 'REQUEST_INFO') newStatus = 'Info Requested';\nelse if (classification.classification === 'AUTO_REPLY') newStatus = 'Applied';\nreturn [{\n  json: {\n    job_id: $json.job_id,\n    job_metadata: $json.job_metadata,\n    classification,\n    new_status: newStatus\n  }\n}];\n"
      },
