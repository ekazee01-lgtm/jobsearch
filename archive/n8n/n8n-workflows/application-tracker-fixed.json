    {
      "parameters": {
        "functionCode": "\nconst apps = $items('Get All Applications');\nconst stats = {\n  total_applications: apps.length,\n  applied: 0,\n  interview_scheduled: 0,\n  in_review: 0,\n  rejected: 0,\n  info_requested: 0,\n  follow_ups_sent: 0\n};\nconst sourceBreakdown = {};\nconst recentActivity = [];\nconst weekAgo = new Date();\nweekAgo.setDate(weekAgo.getDate() - 7);\napps.forEach(item => {\n  const data = item.json;\n  const status = (data.application_status || '').toLowerCase();\n  if (status === 'applied') stats.applied++;\n  if (status.includes('interview')) stats.interview_scheduled++;\n  if (status === 'in review') stats.in_review++;\n  if (status === 'rejected') stats.rejected++;\n  if (status === 'info requested') stats.info_requested++;\n  const metadata = data.metadata || {};\n  if (metadata.followup_count) stats.follow_ups_sent += metadata.followup_count;\n  const source = data.source || 'Unknown';\n  sourceBreakdown[source] = (sourceBreakdown[source] || 0) + 1;\n  const updated = new Date(data.updated_at || data.created_at || new Date());\n  if (updated >= weekAgo) {\n    recentActivity.push(`${data.company} (${data.title}) - ${data.application_status}`);\n  }\n});\nconst report = `\ud83d\udcca Weekly Application Tracker\n\nTotal Applications: ${stats.total_applications}\nApplied: ${stats.applied}\nInterviews Scheduled: ${stats.interview_scheduled}\nIn Review: ${stats.in_review}\nInfo Requested: ${stats.info_requested}\nRejected: ${stats.rejected}\nFollow-ups Sent: ${stats.follow_ups_sent}\n\nTop Sources:\n${Object.entries(sourceBreakdown).sort((a,b)=>b[1]-a[1]).slice(0,5).map(([src,count])=>`\u2022 ${src}: ${count}`).join('\n') || '\u2022 No data'}\n\nRecent Activity:\n${recentActivity.slice(0,10).map(entry=>`\u2022 ${entry}`).join('\n') || '\u2022 No updates in last 7 days'}\n\nGenerated: ${new Date().toLocaleString()}`;\nreturn [{ json: { report } }];\n"
      },
      "id": "report",
      "name": "Generate Weekly Report",
      "type": "n8n-nodes-base.function",
