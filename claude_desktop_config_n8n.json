{
  "mcpServers": {
    "n8n": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-p", "8080:8080",
        "n8nio/n8n-mcp"
      ],
      "env": {
        "N8N_HOST": "localhost",
        "N8N_PORT": "5678",
        "N8N_PROTOCOL": "http"
      }
    }
  }
}